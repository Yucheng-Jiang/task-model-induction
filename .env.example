# Copy to .env and fill in. The pipeline and the grounding service both read it.
# Config files reference these names as `os.environ/<NAME>`, so a stage only
# needs the variables its own provider block uses.

# --- Models ------------------------------------------------------------------
# Every stage in task_model_induction/config.yaml routes through OpenAI, so this
# is the only key you need.
OPENAI_API_KEY=

# --- Grounding service -------------------------------------------------------
# Where step 0 sends grounding requests. Matches the default in config.yaml
# under action_grounding_stage.grounding_url; set it here to override.
# GROUNDING_SERVICE_URL=http://localhost:8000

# --- Config selection --------------------------------------------------------
# Point the pipeline at a different config file.
# TASK_MODEL_INDUCTION_CONFIG=task_model_induction/my-config.yaml
